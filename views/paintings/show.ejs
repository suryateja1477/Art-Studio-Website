<%- include('../partials/header') %>

<div style="margin-bottom: 20px;">
  <a href="/paintings" style="color: var(--text-muted); text-decoration: none; font-size: 0.95rem;">← Back to Gallery</a>
</div>

<div style="background: #ffffff; border: 1px solid var(--border); border-radius: var(--radius); padding: 32px; box-shadow: var(--shadow); display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 36px;">
  <div>
    <div style="border-radius: var(--radius); overflow: hidden; background: #eee; border: 1px solid var(--border);">
      <img
        src="<%= painting.imageUrl %>"
        alt="<%= painting.title %>"
        style="width: 100%; height: auto; max-height: 480px; object-fit: contain; display: block;"
        onerror="this.src='https://via.placeholder.com/600x500?text=Artwork+Image'"
      >
    </div>
  </div>

  <div style="display: flex; flex-direction: column;">
    <div style="margin-bottom: 12px;">
      <span class="badge <%= painting.status === 'available' ? 'badge-available' : 'badge-sold' %>" style="font-size: 0.85rem; padding: 6px 14px;">
        <%= painting.status === 'available' ? '● Available for Purchase' : 'Sold Out' %>
      </span>
    </div>

    <h1 style="font-size: 2rem; font-weight: 700; line-height: 1.25; margin-bottom: 8px;">
      <%= painting.title %>
    </h1>

    <div style="font-size: 1.1rem; color: var(--primary); font-weight: 600; margin-bottom: 20px;">
      By <%= painting.artist %>
    </div>

    <div style="font-size: 2rem; font-weight: 800; color: var(--text); margin-bottom: 24px;">
      ₹<%= painting.price.toLocaleString('en-IN') %>
    </div>

    <div style="border-top: 1px solid var(--border); padding-top: 20px; margin-bottom: 30px; flex: 1;">
      <h3 style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 10px;">About this Artwork</h3>
      <p style="font-size: 1rem; line-height: 1.7; color: var(--text); white-space: pre-line;">
        <%= painting.description %>
      </p>
    </div>

    <div style="border-top: 1px solid var(--border); padding-top: 24px;">
      <% if (!currentUser) { %>
        <div style="background: var(--bg); padding: 16px; border-radius: var(--radius); border: 1px solid var(--border);">
          <p style="margin-bottom: 12px; font-size: 0.95rem;">Please log in with a customer account to purchase this one-of-a-kind artwork.</p>
          <a href="/auth/login" class="btn btn-primary">Log In to Purchase</a>
        </div>
      <% } else if (currentUser.role === 'customer') { %>
        <% if (painting.status === 'available') { %>
          <form action="/orders" method="POST">
            <input type="hidden" name="paintingId" value="<%= painting._id %>">
            <button type="submit" class="btn btn-primary" style="padding: 14px 28px; font-size: 1.1rem; width: 100%;">
              Buy Painting (₹<%= painting.price.toLocaleString('en-IN') %>)
            </button>
            <p class="form-hint" style="text-align: center; margin-top: 8px;">
              ⚡ Instant atomic checkout. You can cancel your order anytime from your dashboard.
            </p>
          </form>
        <% } else { %>
          <button class="btn btn-disabled" disabled style="width: 100%; padding: 14px 28px; font-size: 1.1rem;">
            Sold Out — Unavailable
          </button>
          <p class="form-hint" style="text-align: center; margin-top: 8px;">
            This painting has been purchased by another collector. If they cancel their order, it will reappear as available.
          </p>
        <% } %>
      <% } else if (currentUser.role === 'studio') { %>
        <div style="display: flex; gap: 12px; align-items: center;">
          <% if (painting.status === 'available') { %>
            <a href="/paintings/<%= painting._id %>/edit" class="btn btn-outline" style="padding: 12px 24px;">
              ✏️ Edit Painting Details
            </a>
            <span class="form-hint">Studio Admin Privileges</span>
          <% } else { %>
            <button class="btn btn-disabled" disabled style="padding: 12px 24px;">
              🔒 Sold Painting (Locked from editing)
            </button>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
