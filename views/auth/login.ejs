<%- include('../partials/header') %>

<div class="form-card">
  <h2 style="font-size: 1.5rem; margin-bottom: 8px;">Log In to Art Studio</h2>
  <p class="form-hint" style="margin-bottom: 20px;">Access your customer dashboard or studio management portal.</p>

  <% if (errors && errors.length > 0) { %>
    <div class="flash-message flash-error">
      <ul style="list-style: none;">
        <% errors.forEach(err => { %>
          <li>⚠ <%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/auth/login" method="POST">
    <div class="form-group">
      <label class="form-label" for="email">Email Address</label>
      <input
        type="email"
        id="email"
        name="email"
        class="form-control"
        required
        value="<%= (formData && formData.email) || '' %>"
        placeholder="you@example.com"
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        class="form-control"
        required
        placeholder="••••••••"
      >
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">
      Log In
    </button>
  </form>

  <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 0.9rem;">
    <p>Don't have a customer account? <a href="/auth/register" style="color: var(--primary); font-weight: 600;">Sign up here</a></p>
  </div>
</div>

<%- include('../partials/footer') %>
