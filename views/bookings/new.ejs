<%- include('../partials/header') %>

<div style="margin-bottom: 20px;">
  <a href="/bookings" style="color: var(--text-muted); text-decoration: none;">← View All Bookings</a>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 32px; max-width: 980px; margin: 0 auto; align-items: start;">
  <!-- Left Column: Visual Mockup + Wall Mural Guidelines -->
  <div>
    <div class="card" style="padding: 0; overflow: hidden;">
      <div class="card-img-wrapper" style="height: 240px;">
        <img
          src="/images/Luxury_living_room_interior_2K_20261022123826.jpg"
          alt="Luxury Living Room Wall Mural Mockup"
          class="card-img"
          style="width: 100%; height: 100%; object-fit: cover;"
        >
      </div>
      <div style="padding: 24px;">
        <h3 style="font-size: 1.2rem; margin-bottom: 18px; display: flex; align-items: center; gap: 10px;">
          <span class="atelier-icon-badge" style="width: 30px; height: 30px; margin: 0;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 21h12a2 2 0 0 0 2-2v-2H10v2a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v3h4"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M15 8h-5"/><path d="M15 12h-5"/>
            </svg>
          </span>
          <span>Wall Mural Guidelines</span>
        </h3>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 16px; font-size: 0.92rem; color: var(--text);">
          <li style="display: flex; gap: 12px; align-items: flex-start;">
            <span class="atelier-icon-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/>
              </svg>
            </span>
            <div>
              <strong>Single Booking Per Date:</strong><br>
              <span style="color: var(--text-muted);">Each calendar date can only be booked by one client for full artist focus.</span>
            </div>
          </li>
          <li style="display: flex; gap: 12px; align-items: flex-start;">
            <span class="atelier-icon-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/>
              </svg>
            </span>
            <div>
              <strong>Wall Dimensions:</strong><br>
              <span style="color: var(--text-muted);">Accepts wall surfaces between 10 and 500 sq. ft. at a flat rate of ₹<%= ratePerSqFt %>/sq. ft.</span>
            </div>
          </li>
          <li style="display: flex; gap: 12px; align-items: flex-start;">
            <span class="atelier-icon-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </span>
            <div>
              <strong>Lead Time:</strong><br>
              <span style="color: var(--text-muted);">Bookings must be scheduled between 7 and 90 days in advance.</span>
            </div>
          </li>
          <li style="display: flex; gap: 12px; align-items: flex-start;">
            <span class="atelier-icon-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <div>
              <strong>Cancellation Policy:</strong><br>
              <span style="color: var(--text-muted);">You may cancel free of charge until 3 days before your scheduled date.</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Atelier 3-Stage Process Strip -->
      <div style="border-top: 1px solid var(--border); background: #FAF5F0; padding: 14px 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; text-align: center;">
        <div style="display: flex; flex-direction: column; align-items: center; gap: 5px;">
          <span class="atelier-icon-badge" style="width: 28px; height: 28px; margin: 0; background: #ffffff;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
            </svg>
          </span>
          <span style="font-size: 0.76rem; font-weight: 600; color: var(--text);">Surface Priming</span>
        </div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 5px;">
          <span class="atelier-icon-badge" style="width: 28px; height: 28px; margin: 0; background: #ffffff;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.9a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.5-8.58 3.9a2 2 0 0 1-1.66 0L2.6 12.5"/><path d="m22 17.5-8.58 3.9a2 2 0 0 1-1.66 0L2.6 17.5"/>
            </svg>
          </span>
          <span style="font-size: 0.76rem; font-weight: 600; color: var(--text);">Bespoke Maquette</span>
        </div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 5px;">
          <span class="atelier-icon-badge" style="width: 28px; height: 28px; margin: 0; background: #ffffff;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>
            </svg>
          </span>
          <span style="font-size: 0.76rem; font-weight: 600; color: var(--text);">Wax Topcoat Seal</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column: Schedule Wall Mural Painting Form -->
  <div class="form-card" style="margin: 0; max-width: 100%;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
      <h2 style="font-size: 1.5rem;">Schedule Wall Mural Painting</h2>
      <span class="atelier-icon-badge" style="width: 36px; height: 36px; border-radius: 50%; margin: 0;" title="Dynamic Mural Calculator">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B85D3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6"/><line x1="16" x2="16" y1="14"/><line x1="8" x2="8.01" y1="10"/><line x1="12" x2="12.01" y1="10"/><line x1="16" x2="16.01" y1="10"/><line x1="8" x2="8.01" y1="14"/><line x1="12" x2="12.01" y1="14"/><line x1="8" x2="8.01" y1="18"/><line x1="12" x2="12.01" y1="18"/><line x1="16" x2="16.01" y1="18"/>
        </svg>
      </span>
    </div>
    <p class="form-hint" style="margin-bottom: 24px;">
      Our master artists execute on-site murals for residential and commercial walls.
    </p>

    <% if (errors && errors.length > 0) { %>
      <div class="flash-message flash-error">
        <ul style="list-style: none;">
          <% errors.forEach(err => { %>
            <li>⚠ <%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/bookings" method="POST">
      <div class="form-group">
        <label class="form-label" for="date">Installation Date *</label>
        <input
          type="date"
          id="date"
          name="date"
          class="form-control"
          required
          min="<%= minDate %>"
          max="<%= maxDate %>"
          value="<%= (formData && formData.date) || '' %>"
        >
        <p class="form-hint">
          Must be between 7 and 90 days from today (Open window: <strong><%= minDate %></strong> to <strong><%= maxDate %></strong>).
        </p>
      </div>

      <div class="form-group">
        <label class="form-label" for="wallSizeSqFt">Wall Size (Square Feet: 10 to 500) *</label>
        <input
          type="number"
          id="wallSizeSqFt"
          name="wallSizeSqFt"
          class="form-control"
          min="10"
          max="500"
          required
          value="<%= (formData && formData.wallSizeSqFt) || '50' %>"
          placeholder="e.g. 100"
        >
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
          <input
            type="range"
            id="sizeSlider"
            min="10"
            max="500"
            value="<%= (formData && formData.wallSizeSqFt) || '50' %>"
            style="width: 100%; accent-color: var(--primary); cursor: pointer;"
          >
        </div>
      </div>

      <!-- Live Dynamic Price Display -->
      <div style="background: var(--primary-light); border: 1px solid #f2cdb8; border-radius: var(--radius); padding: 16px; margin-bottom: 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 0.95rem; color: var(--text-muted);">Base Rate: ₹<%= ratePerSqFt %> / sq. ft.</span>
          <span style="font-size: 0.85rem; font-weight: 600; color: var(--primary);">Dynamic Estimate</span>
        </div>
        <div style="font-size: 1.6rem; font-weight: 800; color: var(--primary); margin-top: 6px;" id="priceDisplay">
          ₹<%= ((parseInt((formData && formData.wallSizeSqFt) || '50', 10)) * ratePerSqFt).toLocaleString('en-IN') %>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="address">Full Installation Address *</label>
        <textarea
          id="address"
          name="address"
          rows="3"
          class="form-control"
          required
          placeholder="House/Flat No., Building name, Street, City, Pincode"
        ><%= (formData && formData.address) || '' %></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1.05rem;">
        Request Mural Booking
      </button>
    </form>
  </div>
</div>

<script>
  // Dynamic client-side price calculator
  const sizeInput = document.getElementById('wallSizeSqFt');
  const sizeSlider = document.getElementById('sizeSlider');
  const priceDisplay = document.getElementById('priceDisplay');
  const rate = <%= ratePerSqFt %>;

  function updatePrice(val) {
    const size = parseInt(val, 10) || 0;
    const total = size * rate;
    priceDisplay.textContent = '₹' + total.toLocaleString('en-IN');
  }

  sizeInput.addEventListener('input', (e) => {
    sizeSlider.value = e.target.value;
    updatePrice(e.target.value);
  });

  sizeSlider.addEventListener('input', (e) => {
    sizeInput.value = e.target.value;
    updatePrice(e.target.value);
  });
</script>

<%- include('../partials/footer') %>
